<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Paradise Flavours Mauritius</title>
  <link rel="stylesheet" href="style.css"/>
</head>
<body>

  <header class="hero">
    <div class="overlay">
      <h1>Paradise Flavours 🍽️</h1>
      <p>Luxury Mauritian Restaurant Experience</p>
      <a href="#menu">
        <button>Explore Menu</button>
      </a>
    </div>
  </header>

  <section id="menu">
    <h2>Main Dishes 🍛</h2>

    <div class="cards">

      <div class="card">
        <img src="https://images.unsplash.com/photo-1600891964092-4316c288032e?q=80&w=1200&auto=format&fit=crop">
        <h3>Grilled Chicken</h3>
        <p>Rs 450</p>
      </div>

      <div class="card">
        <img src="https://images.unsplash.com/photo-1621996346565-e3dbc646d9a9?q=80&w=1200&auto=format&fit=crop">
        <h3>Seafood Pasta</h3>
        <p>Rs 620</p>
      </div>

    </div>
  </section>

  <section>
    <h2>Desserts 🍰</h2>

    <div class="cards">

      <div class="card">
        <img src="https://images.unsplash.com/photo-1606313564200-e75d5e30476c?q=80&w=1200&auto=format&fit=crop">
        <h3>Chocolate Lava Cake</h3>
        <p>Rs 280</p>
      </div>

      <div class="card">
        <img src="https://images.unsplash.com/photo-1533134242443-d4fd215305ad?q=80&w=1200&auto=format&fit=crop">
        <h3>Cheesecake</h3>
        <p>Rs 250</p>
      </div>

    </div>
  </section>

  <section>
    <h2>Monthly Deals 🎉</h2>

    <div class="login-box">
      <input type="email" placeholder="Email">
      <input type="password" placeholder="Password">
      <button onclick="showDeal()">Unlock Deals</button>
    </div>

    <div id="dealMessage"></div>

  </section>

  <section class="contact">
    <h2>Contact 📍</h2>
    <p>Royal Road, Port Louis, Mauritius</p>
    <p>+230 5900 1234</p>
    <p>hello@paradiseflavours.mu</p>
  </section>

<script src="script.js"></script>

</body>
</html>